# ============================================================
# ARGUS — Environment Variables Configuration
# ============================================================

# ── 1. GOOGLE MAPS PLATFORM (CORE - REQUIRED) ─────────────
# Enables tactical map rendering, geocoding addresses, and finding nearby CCTV camera positions.
# Required APIs on Google Cloud Console:
#  - Maps JavaScript API
#  - Places API (or Places API New)
#  - Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── 2. OPENAI API (CORE - REQUIRED FOR VISION ANALYSIS) ───
# Used for Vision Language Model (VLM) frame inspection & fallback scripts
OPENAI_API_KEY=your_openai_api_key_here

# ── 3. CEREBRAS API (FAST LLM INFERENCE) ──────────────────
# High-speed LLM for timeline intelligence and broadcast script generation
CEREBRAS_API_KEY=your_cerebras_api_key_here

# ── 4. ELEVENLABS API (VOICEOVER TTS) ─────────────────────
# Generates realistic news anchor voiceovers for alert broadcasts
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── 5. RUNWAY AI API (VIDEO GENERATION) ───────────────────
# Generates synthetic surveillance/incident alert video footage
RUNWAY_API_KEY=your_runway_api_key_here

# ── 6. TWITTER / X API (OPTIONAL - SOCIAL BROADCASTING) ───
# Set to 'false' if you do not want to auto-post broadcasts to X
POST_TO_TWITTER=false
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here
